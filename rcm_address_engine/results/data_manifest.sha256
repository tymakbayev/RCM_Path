# n1    = stream positions [0, 1000000)   = data/ref_n1.*, ref_dyn_base.*, ref_a4_n1.* .. ref_a7_n1.* (all identical)
# n10   = stream positions [0, 10000000)  = data/ref_n10.*, ref_a4_n10.* .. ref_a7_n10.* (all identical)
